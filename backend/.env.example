# Backend environment. Copy to backend/.env for local development.
# Never commit real values — .env is git-ignored.

# Application
# APP_ENV=production makes the API validate Supabase Auth JWTs (see SUPABASE_JWT_SECRET).
APP_ENV=development
DEBUG=false

# CORS: comma-separated list of allowed frontend origins. The defaults cover the Vite dev
# server, its production-build preview (npm run preview, port 4173) and port 3000; set the
# deployed frontend origin (e.g. https://<app>.vercel.app) explicitly in the deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# PostgreSQL connection string (SQLAlchemy async + asyncpg).
# When deployed, this is the Supabase PostgreSQL connection string.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hive_inspect

# Non-owner PostgreSQL role that each request transaction assumes (SET LOCAL ROLE) so the
# auth.uid()-keyed RLS policies in migration 0002 actually apply; the backend publishes the
# authenticated user's claims alongside it. The role is created by
# database/migrations/0003_rls_enforcement.sql, so run that migration before starting the
# API against Supabase. Set empty only for a plain local PostgreSQL with no `auth` schema,
# where 0002 is a no-op and owner_id predicates are the only enforcement point.
DB_APP_ROLE=hive_app

# Supabase Auth (required when APP_ENV=production). Leave both empty here; supply the real
# values through the deployment secret store. Never commit a real value.
#   SUPABASE_JWT_SECRET — project JWT secret (dashboard → Settings → API → JWT Settings).
#                         Signer of every Supabase access token.
#   SUPABASE_URL        — project URL, e.g. https://<project-ref>.supabase.co; when set the
#                         provider also verifies the token's `iss` claim.
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# AI — unused until AI features are scoped. Keep empty for now.
GEMINI_API_KEY=
