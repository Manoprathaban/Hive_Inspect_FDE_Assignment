# Backend environment. Copy to backend/.env for local development.
# Never commit real values — .env is git-ignored.

# Application
APP_ENV=development
DEBUG=false

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL connection string (SQLAlchemy async + asyncpg).
# When deployed, this is the Supabase PostgreSQL connection string.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hive_inspect

# AI — unused until AI features are scoped. Keep empty for now.
# GEMINI_API_KEY=