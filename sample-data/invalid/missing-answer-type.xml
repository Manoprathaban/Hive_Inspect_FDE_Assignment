<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  A structurally valid worksheet that is missing the required "Answer Type" column.
  Four of the five required columns are present, so this proves the importer checks
  for ALL required columns rather than only the first one it happens to read.
  The importer must reject it (API: 422 INVALID_XLSX).
-->
<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
<sheetData>
<row r="1">
<c r="A1" t="inlineStr"><is><t>Section Name</t></is></c>
<c r="B1" t="inlineStr"><is><t>Item Name</t></is></c>
<c r="C1" t="inlineStr"><is><t>Comment Name</t></is></c>
<c r="D1" t="inlineStr"><is><t>Comment Type</t></is></c>
</row>
<row r="2">
<c r="A2" t="inlineStr"><is><t>Kitchen</t></is></c>
<c r="B2" t="inlineStr"><is><t>Lighting</t></is></c>
<c r="C2" t="inlineStr"><is><t>Overhead lights</t></is></c>
<c r="D2" t="inlineStr"><is><t>defect</t></is></c>
</row>
</sheetData>
</worksheet>
