# Frontend environment (public only). Copy to frontend/.env for local development.
# Never put secrets here — the browser ships these values to clients.

# Base URL of the backend API. Defaults to the local FastAPI dev server when unset.
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth (public client values only). Leave unset in development to use the
# deterministic dev session (the backend DevAuthProvider ignores the token value).
# Never put the service-role key or any other secret in the frontend.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<public anon key>
